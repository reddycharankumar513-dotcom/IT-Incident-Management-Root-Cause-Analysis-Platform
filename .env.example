# Application Settings
APP_NAME="IT Incident Management & RCA Platform"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration
DATABASE_URL="sqlite:///./incidents.db"

# Security & Authentication
# AUTH_ENABLED: Set to true to enforce Basic Auth / API Key verification, false for open development
AUTH_ENABLED=true
API_KEY_ADMIN="adm-key-secret-999"
API_KEY_ENGINEER="eng-key-secret-555"
API_KEY_VIEWER="view-key-secret-111"

# Basic Auth Credentials (Format: username:password:role)
# Default users:
# admin:admin123 -> Role: Admin
# engineer:engineer123 -> Role: Engineer
# viewer:viewer123 -> Role: Viewer
BASIC_AUTH_USERS="admin:admin123:Admin,engineer:engineer123:Engineer,viewer:viewer123:Viewer"

# SLA Resolution Targets (in hours)
SLA_RESOLUTION_CRITICAL_HOURS=4.0
SLA_RESOLUTION_HIGH_HOURS=8.0
SLA_RESOLUTION_MEDIUM_HOURS=24.0
SLA_RESOLUTION_LOW_HOURS=72.0

# SLA Response / Acknowledgment Targets (in hours)
SLA_RESPONSE_CRITICAL_HOURS=0.25
SLA_RESPONSE_HIGH_HOURS=0.5
SLA_RESPONSE_MEDIUM_HOURS=2.0
SLA_RESPONSE_LOW_HOURS=4.0

# Logging
LOG_LEVEL="INFO"
LOG_SENSITIVE_DATA_MASKING=true
